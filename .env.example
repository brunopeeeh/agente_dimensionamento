# ============================================================
# Variáveis de ambiente do Yooga Dimensionamento
# ============================================================
# Copie este arquivo para `.env` e preencha os valores reais.
# O `.env` está no .gitignore — nunca comitar credenciais.

# --- Supabase (cliente, seguro expor no browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (servidor) ---
# Senha do banco de dados. Encontrada em:
# https://supabase.com/dashboard/project/<ref>/settings/database
# Usada apenas por `npm run db:migrate` (e `db:link`).
SUPABASE_DB_PASSWORD=

# Service Role Key — Bypassa RLS, usada em handlers server (sync-capacity,
# ai-agent). SEM prefixo VITE_ (server-only). Encontrada em:
# https://supabase.com/dashboard/project/<ref>/settings/api
# NUNCA exponha esta chave no client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Segurança das rotas /api/* (servidor) ---
# Segredo compartilhado exigido no header `x-api-key` de POST /api/sync-capacity
# (rota chamada pelo n8n, que escreve via SERVICE_ROLE_KEY). Sem esta variável
# a rota nega tudo — falha fechado. Gere com: openssl rand -hex 32
API_SHARED_SECRET=

# Origem extra permitida nas rotas /api/* além do próprio host (ex.: domínio de
# preview). Opcional — a UI usa URL relativa e já passa na checagem.
# APP_ORIGIN=https://dimensionamento.suaempresa.com

# --- Freshchat (servidor) ---
# Token Bearer da API Freshchat. SEM prefixo VITE_ (server-only).
# Settings → API tokens no painel Freshchat.
FRESHCHAT_BEARER_TOKEN=

# --- HubSpot Helpdesk (servidor) ---
# Access token do Private App HubSpot. SEM prefixo VITE_ (server-only).
# Settings → Integrations → Private Apps. Escopos necessários:
# crm.objects.owners.read e tickets (read).
# Usado em hubspot.server.ts para somar o volume de tickets por agente.
HUBSPOT_ACCESS_TOKEN=

# --- Provedor de IA (servidor) ---
# O handler ai-agent escolhe o provedor nesta ordem de prioridade:
#   1) NVIDIA API (GLM 5.2)      — se NVIDIA_API_KEY estiver definida
#   2) DeepSeek                  — se DEEPSEEK_API_KEY estiver definida
#   3) Alibaba DashScope (Qwen)  — se DASHSCOPE_API_KEY estiver definida
#   4) OpenRouter                — caso contrário
# Todos usam a API compatível com OpenAI (chat/completions).

# --- NVIDIA API (GLM 5.2) ---
# Chave da API NVIDIA (integrate.api.nvidia.com). SEM prefixo VITE_.
NVIDIA_API_KEY=
# Modelo GLM (opcional). Padrão: z-ai/glm-5.2
NVIDIA_MODEL=z-ai/glm-5.2

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Alibaba DashScope / Model Studio (Qwen) ---
# Chave criada no console da Alibaba Cloud (Model Studio). SEM prefixo VITE_.
DASHSCOPE_API_KEY=
# Modelo Qwen (opcional). Se vazio, usa `qwen3-max`.
# DASHSCOPE_MODEL=qwen3-max

# --- OpenRouter (servidor) ---
# Chave de API do OpenRouter. SEM prefixo VITE_ (server-only).
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
