# ============================================================
# Variáveis de ambiente do Yooga Dimensionamento
# ============================================================
# Copie este arquivo para `.env` e preencha os valores reais.
# O `.env` está no .gitignore — nunca comitar credenciais.

# --- Supabase (cliente, seguro expor no browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (servidor) ---
# Senha do banco de dados. Encontrada em:
# https://supabase.com/dashboard/project/<ref>/settings/database
# Usada apenas por `npm run db:migrate` (e `db:link`).
SUPABASE_DB_PASSWORD=

# Service Role Key — Bypassa RLS, usada em handlers server (sync-capacity,
# ai-agent). SEM prefixo VITE_ (server-only). Encontrada em:
# https://supabase.com/dashboard/project/<ref>/settings/api
# NUNCA exponha esta chave no client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Freshchat (servidor) ---
# Token Bearer da API Freshchat. SEM prefixo VITE_ (server-only).
# Settings → API tokens no painel Freshchat.
FRESHCHAT_BEARER_TOKEN=

# --- Provedor de IA (servidor) ---
# O handler ai-agent escolhe o provedor nesta ordem de prioridade:
#   1) Alibaba DashScope (Qwen)  — se DASHSCOPE_API_KEY estiver definida
#   2) OpenRouter                — caso contrário
# Ambos usam a API compatível com OpenAI (chat/completions).

# --- Alibaba DashScope / Model Studio (Qwen) ---
# Chave criada no console da Alibaba Cloud (Model Studio). SEM prefixo VITE_.
DASHSCOPE_API_KEY=
# Modelo Qwen (opcional). Se vazio, usa `qwen3-max`.
# Ex.: qwen3-max, qwen3-max-preview, qwen-max, qwen-plus.
# DASHSCOPE_MODEL=qwen3-max
# Endpoint (opcional). Padrão: região internacional (Singapura).
# Para a região da China (Pequim), use:
#   https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions

# --- OpenRouter (servidor) ---
# Chave de API do OpenRouter. SEM prefixo VITE_ (server-only).
OPENROUTER_API_KEY=
# Modelo padrão (opcional). Se vazio, usa `openai/gpt-4o-mini`.
# OPENROUTER_MODEL=openai/gpt-4o-mini
